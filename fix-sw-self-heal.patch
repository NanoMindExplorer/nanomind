 about.html    | 29 +++++++++++++++++++++++++++++
 article.html  | 29 +++++++++++++++++++++++++++++
 index.html    | 29 +++++++++++++++++++++++++++++
 telegram.html | 29 +++++++++++++++++++++++++++++
 watch.html    | 29 +++++++++++++++++++++++++++++
 5 files changed, 145 insertions(+)

diff --git a/about.html b/about.html
index b2d712a..b158e2d 100644
--- a/about.html
+++ b/about.html
@@ -3,6 +3,35 @@
 <head>
     <meta charset="UTF-8">
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <script>
+    // SELF-HEAL, sekali per browser: paksa bersihkan Service Worker LAMA +
+    // seluruh Cache Storage, TANPA bergantung ke siklus update SW normal
+    // (yang gak terjamin cepat — bisa nunggu sampai 1 jam / navigasi
+    // berikutnya). Taruh paling awal <head>, sebelum resource lain, supaya
+    // langsung kejadian begitu HTML ini (yang sudah pasti fresh) kebuka.
+    // Naikkan angka di NANOMIND_SW_HEAL_FLAG kalau di masa depan perlu
+    // heal ulang lagi.
+    (function () {
+        var FLAG = 'nanomind_sw_heal_v1';
+        try { if (localStorage.getItem(FLAG) === '1') return; } catch (e) { return; }
+        if (!('serviceWorker' in navigator)) {
+            try { localStorage.setItem(FLAG, '1'); } catch (e) {}
+            return;
+        }
+        Promise.resolve().then(async function () {
+            try {
+                var regs = await navigator.serviceWorker.getRegistrations();
+                await Promise.all(regs.map(function (r) { return r.unregister(); }));
+                if (window.caches) {
+                    var keys = await caches.keys();
+                    await Promise.all(keys.map(function (k) { return caches.delete(k); }));
+                }
+                try { localStorage.setItem(FLAG, '1'); } catch (e) {}
+                if (regs.length) location.reload();
+            } catch (e) { /* biarkan alur normal yang urus kalau ini gagal */ }
+        });
+    })();
+    </script>
     <title>About — Nanomind Explorer</title>
     <meta name="description" content="Tentang penulis di balik Nanomind Explorer — proyek, alat, dan cara menghubungi.">
     <meta name="theme-color" content="#14140F">
