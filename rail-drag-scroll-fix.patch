From 847afa74914d33dc71597583dc5fbdf97ca5df0c Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.local>
Date: Tue, 28 Jul 2026 14:41:28 +0000
Subject: [PATCH] fix: rail X Articles & Medium Articles gak bisa di-drag pakai
 mouse biasa
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

.x-rail sebelumnya cuma overflow-x:auto — jalan lewat sentuhan/trackpad/
scrollbar, tapi mouse tanpa trackpad gak bisa nge-drag isinya.

- script.js: enableRailDragScroll() + setupRailDragScroll(), dipasang ke
  #xArticlesRail dan #mediumArticlesRail. Nge-track jarak drag supaya klik
  link di dalam card gak ke-trigger gak sengaja abis nge-drag.
- style.css: cursor grab/grabbing + matiin scroll-snap & pointer-events
  kartu selama dragging.
---
 script.js | 52 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 style.css |  7 +++++++
 2 files changed, 59 insertions(+)

diff --git a/script.js b/script.js
index 0b3db2f..334040b 100644
--- a/script.js
+++ b/script.js
@@ -60,6 +60,7 @@ document.addEventListener('DOMContentLoaded', () => {
     setupOfflineBanner();
     setupXRetryButtons();
     setupMediumRetryButtons();
+    setupRailDragScroll();
     registerServiceWorker();
     checkAdminSession();
     loadData();
@@ -2598,6 +2599,57 @@ function setupMediumRetryButtons() {
     const b = $('mediumEmptyRetryBtn'); if (b) b.addEventListener('click', retry);
 }
 
+/**
+ * Klik-tahan-geser dengan mouse buat rail horizontal (X/Medium Articles).
+ * .x-rail sebelumnya cuma overflow-x:auto — jalan lewat sentuhan/trackpad/scrollbar,
+ * tapi mouse biasa (tanpa trackpad/touch) gak bisa "nge-drag" isinya.
+ */
+function enableRailDragScroll(rail) {
+    if (!rail || rail.dataset.dragScrollBound) return;
+    rail.dataset.dragScrollBound = '1';
+    let isDown = false;
+    let startX = 0;
+    let startScroll = 0;
+    let moved = 0;
+
+    const onDown = (e) => {
+        isDown = true;
+        moved = 0;
+        startX = e.pageX;
+        startScroll = rail.scrollLeft;
+        rail.classList.add('dragging');
+        e.preventDefault(); // cegah browser nge-drag <img> di dalam card
+    };
+    const onMove = (e) => {
+        if (!isDown) return;
+        const dx = e.pageX - startX;
+        moved = Math.max(moved, Math.abs(dx));
+        rail.scrollLeft = startScroll - dx;
+    };
+    const stop = () => {
+        if (!isDown) return;
+        isDown = false;
+        rail.classList.remove('dragging');
+    };
+
+    rail.addEventListener('mousedown', onDown);
+    window.addEventListener('mousemove', onMove);
+    window.addEventListener('mouseup', stop);
+
+    // Kalau abis nge-drag (bukan klik biasa), jangan biarkan <a> di dalamnya ke-navigasi
+    rail.addEventListener('click', (e) => {
+        if (moved > 6) {
+            e.preventDefault();
+            e.stopPropagation();
+        }
+    }, true);
+}
+
+function setupRailDragScroll() {
+    enableRailDragScroll($('xArticlesRail'));
+    enableRailDragScroll($('mediumArticlesRail'));
+}
+
 function trapFocus(overlay) {
     if (!overlay) return;
     const focusable = overlay.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
diff --git a/style.css b/style.css
index 5ecb1c4..d2e522c 100644
--- a/style.css
+++ b/style.css
@@ -300,7 +300,14 @@ a.text-brass { color: var(--brass); text-decoration: none; border-bottom: 1px so
     -webkit-overflow-scrolling: touch;
     scrollbar-width: thin;
     scrollbar-color: var(--border-ink-strong) transparent;
+    cursor: grab;
 }
+.x-rail.dragging {
+    cursor: grabbing;
+    scroll-snap-type: none;
+    user-select: none;
+}
+.x-rail.dragging .x-card { pointer-events: none; }
 .x-rail::-webkit-scrollbar { height: 6px; }
 .x-rail::-webkit-scrollbar-thumb { background: var(--border-ink-strong); border-radius: 10px; }
 .x-card {
